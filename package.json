{
  "name": "browser-memory",
  "version": "0.1.21",
  "description": "Local MCP server that gives an agent a reusable memory of web actions (learn once, replay deterministically).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://browser-memory.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frisbee-one/browser-memory.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "browser-memory": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/learn && cp src/learn/distill-prompt.md dist/learn/",
    "bundle": "node scripts/bundle.mjs",
    "bundle:verify": "node scripts/bundle-verify.mjs",
    "test": "node --test --import tsx \"./test/*.test.ts\"",
    "smoke": "tsx test/smoke.ts",
    "smoke:composite": "tsx test/smoke-composite.ts",
    "smoke:tabs": "tsx test/smoke-tabs.ts",
    "smoke:explore": "tsx test/smoke-explore.ts",
    "smoke:explore:loop": "TOOL_MEMORY_REGISTRY_ENABLED=0 tsx test/smoke-explore-loop.ts",
    "e2e:remote": "tsx test/e2e-remote.ts",
    "verify:netlog": "tsx test/verify-netlog.ts",
    "inspect": "DANGEROUSLY_OMIT_AUTH=true npx @modelcontextprotocol/inspector npx tsx src/index.ts",
    "inspect:dist": "npm run build && DANGEROUSLY_OMIT_AUTH=true npx @modelcontextprotocol/inspector node dist/index.js",
    "inspect:tools": "npx -y @modelcontextprotocol/inspector --cli npx tsx src/index.ts --method tools/list",
    "inspect:cli": "npx -y @modelcontextprotocol/inspector --cli npx tsx src/index.ts",
    "trace": "python3 webtrace/cctrace.py",
    "trace:web": "python3 webtrace/cctrace_web.py",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "browser-use-sdk": "^3.8.4",
    "playwright": "^1.60.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
