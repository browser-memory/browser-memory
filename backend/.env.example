# Credenciales del Supabase EXISTENTE (proyecto reusado).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service-role (bypassa RLS) — NUNCA exponer al cliente

# Clave para los endpoints /v1/admin/* (header x-admin-key).
ADMIN_API_KEY=cambiame-por-un-secreto-largo

# Puerto del server Express.
PORT=8787
